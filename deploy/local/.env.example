# CCC Internal Documentation — local stack config (connor-server)
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# ---- Image pins (validated on connor-server; bump deliberately + snapshot DB first) ----
BOOKSTACK_TAG=v26.05-ls265
MARIADB_TAG=11.4.12-r0-ls220

# ---- Locale ----
TZ=America/Chicago

# ---- Branding ----
# Site name in the header + browser title. Full theming (colors, logo, a11y CSS) is applied
# via Settings → Customization; see ../branding/README.md.
APP_NAME=CCC Wiki

# ---- Access URL ----
# MUST exactly match how you reach the site in the browser, including scheme and port.
#   LAN access:     APP_URL=http://10.76.88.214        (HTTP_BIND=80)
#   SSH tunnel:     APP_URL=http://localhost:8080       (HTTP_BIND=8080, tunnel 8080->80)
APP_URL=http://10.76.88.214
HTTP_BIND=80

# ---- App key ----
# Generate ONCE (do not reuse this placeholder):
#   docker run --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:latest appkey
# Paste the full "base64:..." value here. NEVER change it later (invalidates sessions/2FA).
APP_KEY=

# ---- Database (container locally; RDS MySQL on AWS) ----
DB_ROOT_PASSWORD=change-me-root
DB_DATABASE=bookstackapp
DB_USERNAME=bookstack
DB_PASSWORD=change-me-app

# ---- Auth ----
# standard = local DB login (default for RBAC/public-read testing).
# saml2    = SSO wiring smoke test against a mock IdP (see README "Optional: SAML smoke test").
AUTH_METHOD=standard
AUTH_AUTO_INITIATE=false

# ---- Revisions ----
# false = unlimited page history. An integer caps it (BookStack default is 100).
REVISION_LIMIT=false

# =====================================================================================
# Optional: SAML2 smoke test (AUTH_METHOD=saml2). These are NOT used when standard.
# Real Vanderbilt Shibboleth is unreachable from the LAN; use a mock IdP container.
# In production these come from VUIT (see ../../docs/runbooks/vuit-coordination-checklist.md).
# =====================================================================================
# SAML2_NAME=Vanderbilt SSO
# SAML2_IDP_ENTITYID=
# SAML2_IDP_SSO=
# SAML2_IDP_SLO=
# SAML2_IDP_x509=
# SAML2_AUTOLOAD_METADATA=false
# SAML2_EMAIL_ATTRIBUTE=mail
# SAML2_DISPLAY_NAME_ATTRIBUTES=givenName|sn
# SAML2_EXTERNAL_ID_ATTRIBUTE=eduPersonPrincipalName
# SAML2_DUMP_USER_DETAILS=true     # bring-up ONLY: prints the assertion so you can read real attribute names
# Group->role sync stays OFF until the real released attribute is confirmed (lockout-class footgun):
# SAML2_USER_TO_GROUPS=false
# SAML2_REMOVE_FROM_GROUPS=false

# =====================================================================================
# Contact-form service (issue #15). Runs behind the `contact` compose profile
# (dev-up.sh enables it). It emails CONTACT_RECIPIENT and optionally files a GitHub
# issue. No-IT delivery path = Proton sender + Brevo SMTP relay (both free).
# Full setup, incl. the Proton + Brevo steps: ../../docs/runbooks/contact-form.md.
# NOTE: docker .env does NOT support inline comments — keep comments on their own line.
# =====================================================================================
# Where the form is reachable; the wiki header "Contact / Feedback" link points here
# (forward link: wiki -> form).
CONTACT_URL=http://localhost:8081/contact
CONTACT_BIND=8081
# Back link: the contact page's logo + "Back to the wiki" point here (form -> wiki).
# Defaults to APP_URL above when unset; set it only to override.
# CONTACT_WIKI_URL=http://10.76.88.214
# Mailbox that receives submissions (your shared mailbox; Contact_form folder via rule).
CONTACT_RECIPIENT=cccadmin@vanderbilt.edu
# Approved-sender gate: only accept submissions from this email domain.
CONTACT_ALLOWED_EMAIL_DOMAIN=vanderbilt.edu

# ---- Mail transport (pick ONE; details in ../../docs/runbooks/contact-form.md) ----
# RECOMMENDED no-IT path: agentmail — an email API for agents (https://agentmail.to).
# Sends from your agentmail.to inbox; AgentMail handles SPF/DKIM/DMARC, so it isn't
# rejected the way free-webmail / Proton senders are by relays. API-key auth, free
# tier (~100/day). You already have ccc-3278@agentmail.to. Reply-To = the submitter.
#   Alternatives: smtp (Gmail App Password / own-domain + Brevo / AWS SES) or
#   graph (Microsoft 365 send-as; needs an Entra app registration / IT).
MAIL_TRANSPORT=agentmail

# -- agentmail (MAIL_TRANSPORT=agentmail) --
AGENTMAIL_INBOX=ccc-3278@agentmail.to
# [SECRET] AgentMail API key from console.agentmail.to (starts with am_):
AGENTMAIL_API_KEY=

# -- smtp alternative (MAIL_TRANSPORT=smtp) --
# Gmail App Password is simplest; MAIL_FROM_ADDRESS MUST equal MAIL_USERNAME.
# SES later: MAIL_HOST=email-smtp.<region>.amazonaws.com.
MAIL_FROM_ADDRESS=cccwiki.contact@gmail.com
MAIL_FROM_NAME=CCC Wiki Contact
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=starttls
# [SECRET] SMTP login (the Gmail address):
MAIL_USERNAME=
# [SECRET] Gmail App Password (16 chars; needs 2-Step Verification on):
MAIL_PASSWORD=

# ---- Optional: also file a GitHub issue per submission ----
# Leave the token blank to disable this channel. Use a fine-grained PAT, issues:write only.
CONTACT_GITHUB_REPO=PMQ9/ccc-internal-documentation
# [SECRET] github_pat_...
CONTACT_INTAKE_GITHUB_TOKEN=

# ---- Optional: Microsoft 365 Graph transport (only if MAIL_TRANSPORT=graph) ----
# MS_TENANT_ID=
# MS_CLIENT_ID=
# [SECRET] MS_CLIENT_SECRET=
# MS_SENDER_UPN=cccadmin@vanderbilt.edu
