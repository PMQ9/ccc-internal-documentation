# Secrets / local config — never commit
.env
*.env
!*.env.example
deploy/local/.env

# Backups / dumps
*.sql
*.tgz
*.tar.gz
backup-*

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
crash.log
crash.*.log
# NOTE: .terraform.lock.hcl IS committed (pins provider versions/hashes) — do not ignore it.

# Generated test artifacts — `make shellcheck` renders user-data to /tmp; on some
# Docker setups (macOS file-mount quirk) an empty stub is left in the repo root.
_user_data.rendered.sh

# Claude Code harness cruft
.claude/scheduled_tasks.lock
.claude/*.lock

# OS / editor
.DS_Store
*.swp

# Python bytecode cache
__pycache__/
*.pyc

# Compiled CLI binary (`make wiki-cli-build`); built from source, never committed.
services/wiki-cli/bin/
